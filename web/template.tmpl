<script type="application/javascript">
// Normalize devicePixelRatio for pygbag (doesn't support fractional DPR like 2.75)
(function() {
    var dpr = window.devicePixelRatio || 1;
    // Round to nearest integer; clamp to [1, 3] for pygbag compatibility
    var safeDPR = Math.max(1, Math.min(3, Math.round(dpr)));
    if (safeDPR !== dpr) {
        Object.defineProperty(window, 'devicePixelRatio', {
            get: function() { return safeDPR; },
            configurable: true
        });
    }
})();

// Pygbag config — let pygbag manage canvas (user_canvas_managed: 0)
config = {
    xtermjs : "{{cookiecutter.xtermjs}}",
    _sdl2 : "canvas",
    user_canvas : 0,
    user_canvas_managed : 0,
    gui_divider : 2,
    ume_block : 0,
    can_close : 0,
    archive : "{{cookiecutter.archive}}",
    gui_debug : 0,
    cdn : "{{cookiecutter.cdn}}",
    autorun : {{cookiecutter.autorun}},
