}

// Wrap pygbag's window_canvas_adjust to catch DPR errors on mobile
(function() {
    // Pygbag calls window_canvas_adjust internally but some mobile DPR
    // values (e.g. 2.75) cause "Unsupported device pixel ratio" errors.
    // Wrap it to silently fall back to DPR=1 when this happens.
    var origAdjust = window.window_canvas_adjust;
    if (origAdjust) {
        window.window_canvas_adjust = function() {
            try {
                return origAdjust.apply(this, arguments);
            } catch (e) {
                if (e.message && e.message.includes('pixel ratio')) {
                    // Temporarily override DPR and retry
                    var realDPR = window.devicePixelRatio;
                    Object.defineProperty(window, 'devicePixelRatio', {
                        value: 1, configurable: true, writable: true
                    });
                    try { return origAdjust.apply(this, arguments); }
                    finally {
                        Object.defineProperty(window, 'devicePixelRatio', {
                            value: realDPR, configurable: true, writable: true
                        });
                    }
                }
                throw e;
            }
        };
    }

    // Resize handler: let pygbag manage canvas sizing
    function onResize() {
        if (typeof window_canvas_adjust === 'function') {
            window_canvas_adjust();
        }
    }
    window.addEventListener('resize', onResize);
    window.addEventListener('orientationchange', function() { setTimeout(onResize, 300); });
})();

function show_infobox() {
    const infobox = document.getElementById("infobox");
