    <script type="application/javascript">
    function handleInfoboxClick() {
        if (window.MM && !window.MM.UME) {
            window.MM.UME = true;
        }
    }

    function toggleFullscreen() {
        const elem = document.getElementById("game-container");
        if (!document.fullscreenElement) {
            if (elem.requestFullscreen) elem.requestFullscreen();
            else if (elem.webkitRequestFullscreen) elem.webkitRequestFullscreen();
            else if (elem.msRequestFullscreen) elem.msRequestFullscreen();
        } else {
            if (document.exitFullscreen) document.exitFullscreen();
        }
    }

    // Key event simulator for virtual touch controls.
    // SDL (pygame-ce WASM) listens for keydown/keyup on `document`,
    // so a single dispatch to document is sufficient (no double events).
    function dispatchKey(type, key, code, keyCode) {
        const evt = new KeyboardEvent(type, {
            key: key,
            code: code,
            keyCode: keyCode,
            which: keyCode,
            bubbles: true,
            cancelable: true
        });
        document.dispatchEvent(evt);
    }

    function bindTouchKey(target, key, code, keyCode, withPress) {
        const el = (typeof target === 'string') ? document.getElementById(target) : target;
        if (!el) return;

        const startHandler = (e) => {
            e.preventDefault();
            el.classList.add('pressed');
            dispatchKey('keydown', key, code, keyCode);
            if (withPress) dispatchKey('keypress', key, code, keyCode);
        };
        const endHandler = (e) => {
            e.preventDefault();
            el.classList.remove('pressed');
            dispatchKey('keyup', key, code, keyCode);
        };

        el.addEventListener('touchstart', startHandler, { passive: false });
        el.addEventListener('touchend', endHandler, { passive: false });
        el.addEventListener('touchcancel', endHandler, { passive: false });
        el.addEventListener('mousedown', startHandler);
        el.addEventListener('mouseup', endHandler);
        el.addEventListener('mouseleave', endHandler);
    }

    bindTouchKey('t-left', 'ArrowLeft', 'ArrowLeft', 37);
    bindTouchKey('t-right', 'ArrowRight', 'ArrowRight', 39);
    bindTouchKey('t-thrust', 'ArrowUp', 'ArrowUp', 38);
    bindTouchKey('t-fire', ' ', 'Space', 32);
    bindTouchKey('t-mute', 'm', 'KeyM', 77);
    bindTouchKey('t-reboot', 'r', 'KeyR', 82);

    // A-Z / 0-9 keypad for pilot ID entry after game over
    (function buildKeypad() {
        const pad = document.getElementById('touch-keypad');
        if (!pad) return;
        const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789".split("");
        for (const ch of chars) {
            const b = document.createElement('button');
            b.className = 'key-btn';
            b.textContent = ch;
            b.setAttribute('aria-label', 'Enter ' + ch);
            const code = (ch >= '0' && ch <= '9') ? 'Digit' + ch : 'Key' + ch;
            bindTouchKey(b, ch, code, ch.charCodeAt(0), true);
            pad.appendChild(b);
        }
        const bs = document.createElement('button');
        bs.className = 'key-btn key-wide';
        bs.textContent = '⌫';
        bs.setAttribute('aria-label', 'Backspace');
        bindTouchKey(bs, 'Backspace', 'Backspace', 8);
        pad.appendChild(bs);
        const en = document.createElement('button');
        en.className = 'key-btn key-wide';
        en.textContent = '⏎';
        en.setAttribute('aria-label', 'Confirm ID');
        bindTouchKey(en, 'Enter', 'Enter', 13, true);
        pad.appendChild(en);
    })();

    (function bindKeypadToggle() {
        const btn = document.getElementById('t-keypad');
        const pad = document.getElementById('touch-keypad');
        if (!btn || !pad) return;
        const toggle = (e) => {
            e.preventDefault();
            pad.classList.toggle('show');
        };
        btn.addEventListener('touchstart', toggle, { passive: false });
        btn.addEventListener('mousedown', toggle);
        btn.addEventListener('click', (e) => e.preventDefault());
    })();

    async function custom_onload(debug_hidden) {
        const pyconsole = document.getElementById("pyconsole");
        const system = document.getElementById("system");
        const transfer = document.getElementById("transfer");
        const box = document.getElementById("box");

        if (pyconsole) pyconsole.hidden = true;
        if (system) system.hidden = true;
        if (box) box.hidden = true;

        show_infobox();
    }

    function custom_prerun() {
        console.log("Asteroids 3D WASM pre-run initialization");
    }

    function custom_postrun() {
        console.log("Asteroids 3D WASM post-run ready");
    }

    function unlockAudio() {
        if (window.MM) {
            window.MM.UME = true;
        }
        if (window.SDL2 && window.SDL2.audioContext && window.SDL2.audioContext.state === 'suspended') {
            window.SDL2.audioContext.resume();
        }
    }
    window.addEventListener('click', unlockAudio);
    window.addEventListener('keydown', unlockAudio);
    window.addEventListener('touchstart', unlockAudio);
    </script>
</body>
